# ==========================================
# Omnimedix Environment Variables (Template)
# ==========================================

# 1. Database Connection (PostgreSQL / Neon Serverless)
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require

# 2. Authentication Secret (JWT)
JWT_SECRET=your_jwt_secret_key_here

# 3. Environment Mode
NODE_ENV=development

# 4. Backend Server Port
PORT=3000

# 5. Frontend API Base URL
VITE_API_BASE_URL=http://localhost:3000
